# ============================================================
#  COPY THIS FILE TO  config/.env  AND FILL IN YOUR VALUES.
#  config/.env is gitignored. NEVER paste real secrets in chat.
# ============================================================

# ---- SAFETY SWITCHES (leave OFF until you trust the system) ----
# DUMMY_MODE=True   -> no real broker calls; trades are SIMULATED + logged.
# EXECUTION_ENABLED -> must ALSO be True for any real order to be placed.
# Both default to the safe value if missing.
DUMMY_MODE=True
EXECUTION_ENABLED=False

# ---- Zerodha Kite Connect (PAID API) ----
KITE_API_KEY=
KITE_API_SECRET=
KITE_USER_ID=
# Optional: enables semi-automated daily login (otherwise you log in manually each morning)
KITE_TOTP_SECRET=
# Access token is regenerated daily by the login flow; usually left blank here.
KITE_ACCESS_TOKEN=

# ---- Telegram ----
# Create a bot with @BotFather to get the token.
TELEGRAM_BOT_TOKEN=
# Your numeric chat id — the bot will ONLY talk to / accept commands from this id.
TELEGRAM_CHAT_ID=

# ---- Claude (synthesis layer) ----
ANTHROPIC_API_KEY=
# Model for synthesis. sonnet = cheaper/faster; opus = deepest reasoning.
CLAUDE_MODEL=claude-sonnet-4-6

# ---- Bright Data (Phase 2 news ingestion) ----
BRIGHTDATA_API_KEY=

# ---- Risk guardrails (defaults shown) ----
MAX_ORDER_VALUE_INR=25000
MAX_DAILY_TRADES=5
APPROVAL_TTL_MINUTES=30

# ---- Market / analysis config ----
SMA_WINDOW=200
TIMEZONE=Asia/Kolkata

# ---- Discovery (YouTube + blogs -> Claude) ----
# True = run offline on bundled sample data, no keys needed (great for a dry run).
DISCOVERY_DRY_RUN=False
MAX_VIDEOS_PER_CHANNEL=4
NEWS_LOOKBACK_DAYS=5
TOP_N_SUGGESTIONS=3

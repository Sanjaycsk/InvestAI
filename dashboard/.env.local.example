# ---- Notion (live data source) ----
# Create an internal integration at https://www.notion.so/my-integrations
# then share the INVESTAI page with it (•••  ->  Connections  ->  your integration).
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Data source IDs (already known for this workspace)
NOTION_RECOMMENDATIONS_DS=8f225b65-31b3-4f12-9700-34e7a2a459e0
NOTION_DAILY_REVIEW_DS=a69929f7-e386-4d9a-bf60-16f468dd4325

# ---- Access control (shared passcode) ----
# The passcode people type on the login screen.
DASHBOARD_PASSCODE=change-me-to-something-only-you-share

# A long random string used as the session cookie value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_SESSION_SECRET=replace-with-a-long-random-hex-string
